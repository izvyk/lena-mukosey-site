<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
    {% block head %}
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="robots" content="index,follow">
        <meta name="googlebot" content="index,follow">

        <meta name="author" content="{{ 'meta.author' | i18n }}">
        <meta name="description" content="{{ 'meta.description' | i18n }}">
        <meta name="copyright" content="Copyright 2014 – current Lena Mukosey. При цитировании ссылка (гиперссылка) на источник обязательна. Все логотипы и названия принадлежат их уважаемым владельцам.">
        <meta name="keywords" content="{{ 'meta.keywords' | i18n }}">

        <title>{{ title }}</title>

        <!-- Yandex.Metrika counter --> <script type="text/javascript" > (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)}; m[i].l=1*new Date(); for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }} k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)}) (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym"); ym(94506450, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true }); </script> <noscript><div><img src="https://mc.yandex.ru/watch/94506450" style="position:absolute; left:-9999px;" alt="" /></div></noscript> <!-- /Yandex.Metrika counter -->

        <link rel="icon" href="/assets/favicon/duck_lusha_final.svg" type="image/svg+xml">
        <link rel="icon" href="/assets/favicon/favicon_for_dark.png" type="image/png" media="(prefers-color-scheme: dark)" sizes="any">
        <link rel="icon" href="/assets/favicon/favicon_for_light.png" type="image/png" media="(prefers-color-scheme: light)" sizes="any">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;500&display=swap" rel="stylesheet">

        <link rel="alternate" hreflang="{{ page.lang }}" href="{{ page.url }}">
        {% for link in page.url | locale_links %}
          <link rel="alternate" hreflang="{{ link.lang }}" href="{{ link.url }}">
        {% endfor %}

        {% if scss is defined %}
            {# <link rel="stylesheet" type="text/css" href="{{ style | prefixWithStylesPath | rev }}"> #}
            <style>
                {{ scss | safe }}
            </style>
        {% endif %}
    {% endblock %}

    {% if script is defined %}
        {% set js %}
            {% include "../assets-inline/script/" + script %}
        {% endset %}
        <script>
            {{ js | safe }}
        </script>
    {% endif %}
</head>
<body {% if '/info' in page.url %} itemscope itemtype="https://schema.org/Person" {% endif %}>
    {% block header %}
        {% include 'default-header.njk' %}
    {% endblock %}

    {% block content %}
        <main>
            {{ content | safe }}
        </main>
    {% endblock %}

    {% block footer %}
        {% include 'default-footer.njk' %}
    {% endblock footer %}

    <script>
        (function () {
            var currentAnchor = null;
            var scheduled = false;
            var switching = false;

            function updateFooterYear() {
                var year = document.querySelector('.current-year');
                if (year) year.textContent = new Date().getFullYear();
            }

            function updateAnchor() {
                var works = document.querySelectorAll('main > div[id]');
                var anchor = null;

                for (var i = 0; i < works.length; i++) {
                    if (works[i].getBoundingClientRect().top <= window.innerHeight / 2) anchor = works[i];
                    else break;
                }

                var id = anchor && anchor.id;
                if (id === currentAnchor) return;

                currentAnchor = id;
                // replaceState keeps the shareable link without adding history entries.
                history.replaceState(null, '', id ? '#' + id : location.pathname + location.search);
            }

            function swapLanguage(url, addToHistory) {
                var scrollY = window.scrollY;

                return fetch(url)
                    .then(function (response) {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.text();
                    })
                    .then(function (html) {
                        var doc = new DOMParser().parseFromString(html, 'text/html');

                        var replacements = ['header', 'main', 'footer'].map(function (selector) {
                            var current = document.body.querySelector(selector);
                            var next = doc.body.querySelector(selector);

                            if (!current || !next) throw new Error('Missing ' + selector);
                            return [current, document.importNode(next, true)];
                        });

                        document.title = doc.title;
                        document.documentElement.lang = doc.documentElement.lang;

                        // The two language pages share CSS and structure, so only replace their content regions.
                        replacements.forEach(function (replacement) {
                            replacement[0].replaceWith(replacement[1]);
                        });

                        updateFooterYear();
                        window.scrollTo(0, scrollY);

                        if (addToHistory) history.pushState(null, '', url);

                        currentAnchor = null;
                        updateAnchor();
                    });
            }

            updateFooterYear();

            window.addEventListener('scroll', function () {
                if (scheduled) return;
                scheduled = true;
                requestAnimationFrame(function () {
                    scheduled = false;
                    updateAnchor();
                });
            }, { passive: true });

            window.switchLanguage = function (link, event) {
                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;

                event.preventDefault();
                if (switching) return;
                switching = true;
                var url = link.href.split('#')[0] + location.hash;

                swapLanguage(url, true).catch(function (error) {
                    console.error('Language switch failed:', error);
                    location.href = url;
                }).then(function () {
                    switching = false;
                });
            };

            window.addEventListener('popstate', function () {
                swapLanguage(location.href, false).catch(function (error) {
                    console.error('History navigation failed:', error);
                    location.reload();
                });
            });
        })();
    </script>
</body>
</html>