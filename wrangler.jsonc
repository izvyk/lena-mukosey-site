{
  "name": "lena-mukosey-site",
  "compatibility_date": "2026-11-01",
  // Static site only: Eleventy builds into public/, no Worker script.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Serve only on the custom domain, which Cloudflare Access protects.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lena.mukosey.de", "custom_domain": true }]
}
